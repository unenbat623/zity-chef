# ── ZITY CHEF ENVIRONMENT CONFIGURATION ──────────────────────────────────────

# Node Environment ('production' or 'development')
NODE_ENV=production

# Server Port (Default: 3002 or allocated by Render/Fly/Vercel/Railway)
PORT=3002

# ── AI provider ───────────────────────────────────────────────────────────────
# AI_PROVIDER: 'gemini' | 'ollama' | (unset = auto: Gemini if key, else Ollama)
AI_PROVIDER=

# Option 1 — Google Gemini (best Mongolian quality; free tier at aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here

# Option 2 — Ollama (FREE, local, no API key). Run:  ollama serve  (or Docker)
#   then:  ollama pull llama3.2:1b
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:1b

# ── AI tuning (all optional — sensible defaults are compiled in) ─────────────
# Gemini model id and generation settings.
AI_MODEL=
AI_THINKING_LEVEL=
AI_MAX_OUTPUT_TOKENS=
# How long an identical answer is reused (minutes). Cache hits cost nothing.
AI_CACHE_TTL_MINUTES=
# Per-tier daily request allowance (defaults: 2 / 100 / 300).
AI_FREE_DAILY_LIMIT=
AI_PRO_DAILY_LIMIT=
AI_FAMILY_DAILY_LIMIT=
# App-wide daily ceiling across ALL users — the spend guard (default 900).
AI_GLOBAL_DAILY_LIMIT=

# ── Supabase (Auth + per-user database) ──────────────────────────────────────
# Dashboard → Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
# service_role key — SERVER ONLY, never ship to the browser
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
# anon (public) key — used by the server to create RLS-scoped user clients
SUPABASE_ANON_KEY=your_supabase_anon_key_here
# JWT secret (Settings → API → JWT Settings) — lets the API verify access
# tokens locally (fast, no network). Optional but recommended.
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_here
# Comma-separated chef/admin accounts allowed to view aggregate customer/order dashboard.
CHEF_ADMIN_EMAILS=chef@zitychef.mn,admin@zitychef.mn

# ── Odoo bridge (server-only; never expose these as VITE_* values) ───────────
ODOO_URL=https://your-odoo-host.example.com
ODOO_DB=your_odoo_database
ODOO_USERNAME=api-user@example.com
ODOO_API_KEY=your_odoo_api_key
# Optional request/product limits
ODOO_TIMEOUT_MS=15000
ODOO_PRODUCT_LIMIT=200
ODOO_AUTO_SYNC_ORDERS=true
# Invoice each order as it syncs, and register the payment when it was prepaid.
# Set to false only if you invoice on delivery instead.
ODOO_AUTO_INVOICE_ORDERS=true
# Marking an order delivered in Chef validates its Odoo delivery order, so the
# warehouse figures actually move. Set to false to ship from Odoo by hand.
ODOO_VALIDATE_DELIVERY=true
# Reconciliation writes an Odoo cancellation back into Chef: the order stops,
# its stock returns and the points spent on it are refunded. Set to false to
# have reconciliation report the drift without acting on it.
ODOO_APPLY_CANCELLATIONS=true
# How often the long-running server reconciles Chef against Odoo (minutes).
# 0 turns it off — use a platform cron against POST /api/odoo/reconcile instead
# (serverless deployments have no timers).
ODOO_RECONCILE_INTERVAL_MINUTES=60
# Service product a Zity points discount is booked against, so Odoo invoices the
# amount that was actually charged. Created by `npm run odoo:seed`.
ODOO_POINTS_PRODUCT_SKU=POINTSDISCOUNT
# Optional delivery fee line product. Prefer ID if known, otherwise SKU/default_code.
ODOO_DELIVERY_PRODUCT_ID=
ODOO_DELIVERY_PRODUCT_SKU=DELIVERY
# Optional sale.order defaults
ODOO_PRICELIST_ID=
ODOO_SALES_TEAM_ID=
ODOO_SALESPERSON_ID=
# res.company id — Settings > Users & Companies > Companies.
ODOO_COMPANY_ID=
# Accounting journals — Accounting > Configuration > Journals. Both are
# per-database ids, so copy them from the Odoo instance you are deploying
# against rather than from another environment.
# Payment journal marks online invoices paid via account.payment.register and
# must be type "bank" or "cash". Credit note journal reverses cancelled or
# refunded invoices via account.move.reversal and must be the type "sale"
# journal that customer invoices are posted to — otherwise the reversal lands
# in a different ledger than the invoice it cancels.
ODOO_PAYMENT_JOURNAL_ID=
ODOO_CREDIT_NOTE_JOURNAL_ID=

# ── Smoke tests (local operator only; do not set in browser env) ──────────────
# Without SMOKE_ACCESS_TOKEN the smoke run only covers /api/odoo/status and
# skips every authenticated check, while still exiting 0 — a green run with
# SKIP lines has verified far less than it looks like.
# Fill both values with `npm run odoo:credentials`, which mints a chef-admin
# token and picks a syncable order. Falling back manually: sign in to the Chef
# UI as an address in CHEF_ADMIN_EMAILS and copy the token from DevTools >
# Application > Local Storage > sb-*-auth-token > access_token. Admin rights
# are required — /logs and /reconcile answer CHEF_ADMIN_REQUIRED to a
# signed-in non-admin.
# SMOKE_ORDER_ID additionally unlocks the order lifecycle checks and must be an
# order that already reached status paid/packing/shipping/delivered, since
# earlier statuses are rejected with "Only paid orders can be synced to Odoo".
# The lifecycle checks WRITE to Odoo — they create a sale order and an invoice.
SMOKE_API_URL=https://your-production-domain.example.com
SMOKE_ACCESS_TOKEN=
SMOKE_ORDER_ID=

# Direct Postgres connection — required by `npm run db:push` (migrations) only.
# Dashboard → Project Settings → Database → Connection string (URI).
DIRECT_URL=postgresql://postgres:your_password@db.your-project-ref.supabase.co:5432/postgres

# Google sign-in, when running Supabase locally (supabase/config.toml). On a
# hosted project these are set in the Supabase dashboard instead.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# Google/Gmail sign-in is configured in Supabase Dashboard:
# Authentication → Providers → Google, then add the callback URL shown by Supabase
# to Google Cloud OAuth Client Authorized redirect URIs.

# ── QPay v2 (optional — real payments; falls back to a simulated flow) ────────
# Merchant credentials from QPay (https://qpay.mn).
#
# Until all three are set the payment modal runs a simulated QR flow: orders are
# created but no money moves, and every cancelled order lands in the manual
# refund queue because there is nothing to send back. In production the invoice
# endpoint refuses outright (503 PAYMENTS_UNAVAILABLE) rather than making every
# basket free.
#
# After filling these in, run `npm run qpay:check` — it authenticates against
# the live merchant API, raises one small invoice to prove the invoice_code
# works, and confirms QPay can reach the callback.
QPAY_BASE_URL=https://merchant.qpay.mn/v2
QPAY_USERNAME=your_qpay_username
QPAY_PASSWORD=your_qpay_password
QPAY_INVOICE_CODE=your_qpay_invoice_code
# Public https URL QPay calls when an invoice is paid. Must be reachable from
# the internet — set it with `npm run domain:set` rather than by hand, so the
# other seven domain-dependent values stay in step with it.
QPAY_CALLBACK_URL=https://zitychef.mn/api/payments/qpay/callback

# ── Web Push (VAPID) — expiry reminders ──────────────────────────────────────
# Generate once with: node -e "console.log(require('web-push').generateVAPIDKeys())"
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_SUBJECT=mailto:admin@zitychef.mn

# ── Upstash Redis (optional — shared cache + rate limiting across instances) ──
# Without these, the server uses an in-memory cache/limiter (single-instance).
# Create a database at https://upstash.com → REST API section.
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token

# Allowed CORS origins (comma-separated list of your production frontend domains)
ALLOWED_ORIGINS=https://zitychef.mn,https://zity-chef.onrender.com,http://localhost:3000

# ── Frontend (Vite — must be prefixed with VITE_, exposed to the browser) ─────
# Same Supabase project; the anon key is safe in the browser (RLS protects data).
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
# Backend API base URL. Leave empty in production if the API is same-origin.
# Leave empty for local/mobile dev; the browser will call the same host on :3002
# (example: http://10.20.19.58:3000 -> API http://10.20.19.58:3002).
VITE_API_URL=
# Optional fixed OAuth return URL. For phone testing, use your computer LAN URL
# and add the exact same URL to Supabase Auth Redirect URLs.
VITE_AUTH_REDIRECT_URL=http://localhost:3000
# Sentry error tracking (optional — the SDK loads only when this is set).
VITE_SENTRY_DSN=
