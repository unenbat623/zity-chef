# ── ZITY CHEF ENVIRONMENT CONFIGURATION ──────────────────────────────────────

# Node Environment ('production' or 'development')
NODE_ENV=production

# Server Port (Default: 3002 or allocated by Render/Fly/Vercel/Railway)
PORT=3002

# Google Gemini AI API Key (Required for real AI responses & OCR)
# Get your key from: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# ── Supabase (Auth + per-user database) ──────────────────────────────────────
# Dashboard → Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
# service_role key — SERVER ONLY, never ship to the browser
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
# anon (public) key — used by the server to create RLS-scoped user clients
SUPABASE_ANON_KEY=your_supabase_anon_key_here
# JWT secret (Settings → API → JWT Settings) — lets the API verify access
# tokens locally (fast, no network). Optional but recommended.
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_here

# Allowed CORS origins (comma-separated list of your production frontend domains)
ALLOWED_ORIGINS=https://zitychef.mn,https://zity-chef.onrender.com,http://localhost:3000

# ── Frontend (Vite — must be prefixed with VITE_, exposed to the browser) ─────
# Same Supabase project; the anon key is safe in the browser (RLS protects data).
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
# Backend API base URL. Leave empty in production if the API is same-origin.
VITE_API_URL=http://localhost:3002
