# ── ZITY CHEF ENVIRONMENT CONFIGURATION ──────────────────────────────────────

# Node Environment ('production' or 'development')
NODE_ENV=production

# Server Port (Default: 3002 or allocated by Render/Fly/Vercel/Railway)
PORT=3002

# ── AI provider ───────────────────────────────────────────────────────────────
# AI_PROVIDER: 'gemini' | 'ollama' | (unset = auto: Gemini if key, else Ollama)
AI_PROVIDER=

# Option 1 — Google Gemini (best Mongolian quality; free tier at aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here

# Option 2 — Ollama (FREE, local, no API key). Run:  ollama serve  (or Docker)
#   then:  ollama pull llama3.2:1b
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:1b

# ── Supabase (Auth + per-user database) ──────────────────────────────────────
# Dashboard → Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
# service_role key — SERVER ONLY, never ship to the browser
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
# anon (public) key — used by the server to create RLS-scoped user clients
SUPABASE_ANON_KEY=your_supabase_anon_key_here
# JWT secret (Settings → API → JWT Settings) — lets the API verify access
# tokens locally (fast, no network). Optional but recommended.
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_here
# Comma-separated chef/admin accounts allowed to view aggregate customer/order dashboard.
CHEF_ADMIN_EMAILS=chef@zitychef.mn,admin@zitychef.mn

# Google/Gmail sign-in is configured in Supabase Dashboard:
# Authentication → Providers → Google, then add the callback URL shown by Supabase
# to Google Cloud OAuth Client Authorized redirect URIs.

# ── QPay v2 (optional — real payments; falls back to a simulated flow) ────────
# Merchant credentials from QPay (https://qpay.mn). Without these, the payment
# modal runs a working simulated QR flow.
QPAY_BASE_URL=https://merchant.qpay.mn/v2
QPAY_USERNAME=your_qpay_username
QPAY_PASSWORD=your_qpay_password
QPAY_INVOICE_CODE=your_qpay_invoice_code
# Public URL QPay calls when an invoice is paid (webhook).
QPAY_CALLBACK_URL=https://zitychef.mn/api/payments/qpay/callback

# ── Web Push (VAPID) — expiry reminders ──────────────────────────────────────
# Generate once with: node -e "console.log(require('web-push').generateVAPIDKeys())"
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_SUBJECT=mailto:admin@zitychef.mn

# ── Upstash Redis (optional — shared cache + rate limiting across instances) ──
# Without these, the server uses an in-memory cache/limiter (single-instance).
# Create a database at https://upstash.com → REST API section.
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token

# Allowed CORS origins (comma-separated list of your production frontend domains)
ALLOWED_ORIGINS=https://zitychef.mn,https://zity-chef.onrender.com,http://localhost:3000

# ── Frontend (Vite — must be prefixed with VITE_, exposed to the browser) ─────
# Same Supabase project; the anon key is safe in the browser (RLS protects data).
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
# Backend API base URL. Leave empty in production if the API is same-origin.
# Leave empty for local/mobile dev; the browser will call the same host on :3002
# (example: http://10.20.19.58:3000 -> API http://10.20.19.58:3002).
VITE_API_URL=
# Optional fixed OAuth return URL. For phone testing, use your computer LAN URL
# and add the exact same URL to Supabase Auth Redirect URLs.
VITE_AUTH_REDIRECT_URL=http://localhost:3000
# Sentry error tracking (optional — the SDK loads only when this is set).
VITE_SENTRY_DSN=
